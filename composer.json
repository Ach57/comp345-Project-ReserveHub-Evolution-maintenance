{
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "files": [
            "src/Helpers/TimeHelpers.php",
            "src/Helpers/ProfileHelpers.php",
            "src/Helpers/LoginHelpers.php",
            "src/Helpers/LanguageHelpers.php",
            "src/Helpers/ForgotPasswordHelpers.php",
            "src/Helpers/ResetPasswordHelpers.php",
            "src/Helpers/SearchHelpers.php",
            "src/Helpers/SignupHelpers.php",
            "src/Helpers/ExportHelpers.php",
            "src/Helpers/EnvironmentHelpers.php",
            "src/Helpers/AdminApiHelpers.php",
            "src/Helpers/IdHelpers.php",
            "src/Helpers/ReserveHelpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit --testsuite unit --log-junit tests/logs/unit-results.xml --testdox-html tests/logs/unit-results.html",
        "test:integration": "phpunit --testsuite integration --log-junit tests/logs/integration-results.xml --testdox-html tests/logs/integration-results.html"
    }
}